# ── Google AI Studio (Gemini TTS) ───────────────────────────────
# Chave em https://aistudio.google.com/apikey — fica só no servidor.
NUXT_GEMINI_API_KEY=
NUXT_TTS_MODEL=gemini-3.8-flash-lite-tts
# Vozes pré-definidas do Gemini (não aparecem na interface)
NUXT_TTS_VOICE_FEMALE=Sulafat
NUXT_TTS_VOICE_MALE=Algieba
# Gerações novas por IP por hora (cache não conta)
NUXT_TTS_RATE_LIMIT_PER_HOUR=20

# ── App ─────────────────────────────────────────────────────────
# URL pública absoluta (usada no og:image / og:url)
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Dias que uma declaração publicada fica no ar
NUXT_PUBLIC_DECLARATION_TTL_DAYS=7
NUXT_PUBLIC_MAX_PHOTOS=10
NUXT_PUBLIC_MAX_DECLARATION_CHARS=1000

# ── Pós-piloto (ainda não usados) ───────────────────────────────
# NUXT_OAUTH_GOOGLE_CLIENT_ID=
# NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# NUXT_SESSION_PASSWORD=
# NUXT_R2_ACCOUNT_ID=
# NUXT_R2_ACCESS_KEY_ID=
# NUXT_R2_SECRET_ACCESS_KEY=
# NUXT_R2_BUCKET=
# NUXT_PAYMENT_PROVIDER=
